{
  "name": "@btst/plugin-route-docs",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-stack-ai/better-stack.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "description": "Client route documentation and sitemap introspection for the BTST core runtime.",
  "exports": {
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./css": "./dist/style.css"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "unbuild --clean",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@btst/stack": ">=6.2.0 <6.3.0",
    "@btst/yar": ">=1.3.2",
    "@tanstack/react-query": "^5.0.0",
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6",
    "tailwindcss": ">=4.3.2"
  },
  "devDependencies": {
    "@btst/stack": "workspace:*",
    "@btst/yar": "1.3.2",
    "@tanstack/react-query": "5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "@workspace/ui": "workspace:*"
  }
}
