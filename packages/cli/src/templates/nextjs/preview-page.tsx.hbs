import { headers } from "next/headers"
import { getServerClientOriginsFromHeaders } from "{{alias}}lib/stack-client.server"
import PreviewPageClient from "./client"

/**
 * Server component that resolves params for React 18/19 compatibility.
 * In Next.js 15+, params is a Promise that must be awaited server-side.
 */
export default async function PreviewPage({
	params,
}: {
	params: Promise<{ slug: string }>
}) {
	const [{ slug }, requestHeaders] = await Promise.all([params, headers()])
	const clientOrigins = getServerClientOriginsFromHeaders(requestHeaders)
	return <PreviewPageClient slug={slug} clientOrigins={clientOrigins} />
}
