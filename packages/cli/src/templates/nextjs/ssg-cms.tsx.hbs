/** Legacy example URL. CMS management data must render through request authorization. */
import { redirect } from "next/navigation"

export default async function LegacyCmsManagementPage({
	params,
}: {
	params: Promise<{ typeSlug: string }>
}) {
	const { typeSlug } = await params
	redirect(`/pages/cms/${encodeURIComponent(typeSlug)}`)
}
