"use client"

import { ChatLayout } from "@btst/stack/plugins/ai-chat/client"
import { StackProvider } from "@btst/stack/context"
import { nextRouter } from "@btst/stack/next"
import { QueryClientProvider } from "@tanstack/react-query"
import { useMemo } from "react"
import { getOrCreateQueryClient } from "{{alias}}lib/query-client"
import { getStackClient } from "{{alias}}lib/stack-client"

/**
 * Public Chat Page — AI chat in public mode (no login required).
 * Renders a full-screen chat interface using the ai-chat plugin.
 */
export default function PublicChatPage() {
	const queryClient = getOrCreateQueryClient()
	const browserStack = useMemo(
		() => getStackClient(queryClient),
		[queryClient],
	)

	return (
		<QueryClientProvider client={queryClient}>
			<StackProvider
				stack={browserStack}
				router={nextRouter()}
{{#if pagesLayoutOverrides}}
				overrides={
					{
{{{pagesLayoutOverrides}}}
					}
				}
{{/if}}
			>
				<div className="min-h-screen bg-background">
					<main className="h-screen">
						<ChatLayout />
					</main>
				</div>
			</StackProvider>
		</QueryClientProvider>
	)
}
