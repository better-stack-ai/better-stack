import { headers } from "next/headers"
import { getServerClientOriginsFromHeaders } from "{{alias}}lib/stack-client.server"
import PublicChatPageClient from "./client"

/**
 * Public Chat Page — AI chat in public mode (no login required).
 * Renders a full-screen chat interface using the ai-chat plugin.
 */
export default async function PublicChatPage() {
	const clientOrigins = getServerClientOriginsFromHeaders(await headers())
	return <PublicChatPageClient clientOrigins={clientOrigins} />
}
