import type { ReactNode } from "react"
import { BtstPagesClientLayout } from "./client-layout"
import { getServerClientOrigins } from "{{alias}}lib/stack-client.server"

export default function BtstPagesLayout({
	children,
}: {
	children: ReactNode
}) {
	const clientOrigins = getServerClientOrigins()
	return (
		<BtstPagesClientLayout clientOrigins={clientOrigins}>
			{children}
		</BtstPagesClientLayout>
	)
}
