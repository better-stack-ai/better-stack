import type { ReactNode } from "react"
import { headers } from "next/headers"
import { BtstPagesClientLayout } from "../../pages/client-layout"
import { getServerClientOriginsFromHeaders } from "{{alias}}lib/stack-client.server"

export default async function BtstPagesLayout({
	children,
}: {
	children: ReactNode
}) {
	const clientOrigins = getServerClientOriginsFromHeaders(await headers())
	return (
		<BtstPagesClientLayout clientOrigins={clientOrigins}>
			{children}
		</BtstPagesClientLayout>
	)
}
