import { headers } from "next/headers"
import { getServerClientOriginsFromHeaders } from "{{alias}}lib/stack-client.server"
import FormDemoPageClient from "./client"

/**
 * Public form demo page — renders any published form by slug.
 * Access at: /form-demo/<form-slug>
 */
export default async function FormDemoPage({
	params,
}: {
	params: Promise<{ slug: string }>
}) {
	const [{ slug }, requestHeaders] = await Promise.all([params, headers()])
	const clientOrigins = getServerClientOriginsFromHeaders(requestHeaders)
	return <FormDemoPageClient slug={slug} clientOrigins={clientOrigins} />
}
