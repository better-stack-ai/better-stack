"use client"

{{{resourceCommentsImports}}}
{{#if hasMediaIntegration}}
import { createMediaOverrides } from "{{alias}}components/media-overrides"
{{#if hasEcommerce}}
import { ProductImagesField } from "@btst/plugin-ecommerce/client/components"
{{/if}}
{{/if}}

{{#if hasBlogNewsletter}}
import { NewsletterAction, BlogCampaignSource } from "@btst/plugin-newsletter/client/blog-integration"
{{/if}}
import { ChatLayout } from "@btst/plugin-ai-chat/client"
import { StackProvider } from "@btst/stack/context"
import { nextRouter } from "@btst/stack/next"
import { QueryClientProvider } from "@tanstack/react-query"
import { useMemo } from "react"
import { getOrCreateQueryClient } from "{{alias}}lib/query-client"
import { getStackClient, type StackClientOptions } from "{{alias}}lib/stack-client"

export default function PublicChatPageClient({
	clientOrigins,
}: {
	clientOrigins: StackClientOptions
}) {
	const queryClient = getOrCreateQueryClient()
	const browserStack = useMemo(
		() => getStackClient(queryClient, clientOrigins),
		[clientOrigins.apiOrigin, clientOrigins.siteOrigin, queryClient],
	)

{{#if hasMediaIntegration}}
	const mediaOverrides = useMemo(() => createMediaOverrides(), [browserStack])
{{/if}}
	return (
		<QueryClientProvider client={queryClient}>
			<StackProvider
				stack={browserStack}
				router={nextRouter()}
{{#if embeddedOverrides}}
				overrides={
					{
{{{embeddedOverrides}}}
					}
				}
{{/if}}
			>
{{#if hasMediaIntegration}}
				<mediaOverrides.UploadBinding />
{{/if}}
				<div className="min-h-screen bg-background">
					<main className="h-screen">
						<ChatLayout />
					</main>
				</div>
			</StackProvider>
		</QueryClientProvider>
	)
}
