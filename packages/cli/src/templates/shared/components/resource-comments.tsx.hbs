"use client"

import { CommentThread } from "@btst/plugin-comments/client/components"
{{#if hasKanbanComments}}
{{{commentsPathImport}}}
{{/if}}
{{#if hasSchoolComments}}
import type { Lesson } from "@btst/plugin-school/types"
{{/if}}
{{#if hasKanbanComments}}
import type { SerializedTask } from "@btst/plugin-kanban/types"
{{/if}}
{{#if hasSchoolComments}}

export function SchoolLessonComments({ lesson }: { lesson: Lesson }) {
	return <CommentThread resourceId={`${encodeURIComponent(lesson.courseId)}/lessons/${encodeURIComponent(lesson.id)}`} resourceType="school-lesson" />
}
{{/if}}
{{#if hasKanbanComments}}

export function KanbanTaskComments({ task }: { task: SerializedTask }) {
	const pathname = {{{commentsPathExpression}}}
	// Tasks do not contain their board ID; retain it for navigation.
	const boardId = pathname.split("/kanban/")[1]?.split("/")[0]
	if (!boardId) return null
	return <CommentThread resourceId={`${boardId}/${encodeURIComponent(task.id)}`} resourceType="kanban-task" />
}
{{/if}}
