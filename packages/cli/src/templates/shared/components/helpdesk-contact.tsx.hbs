"use client"

import { Suspense, useEffect, useState } from "react"
import { PermissionAccess, usePluginSiteNavigation } from "@btst/stack/context"
import { crmPermissions } from "@btst/plugin-crm/permissions"
import { useContacts } from "@btst/plugin-crm/client/hooks"
import type { HelpdeskTicketDetail } from "@btst/plugin-helpdesk/types"

export function HelpdeskContact({ ticket }: { ticket: HelpdeskTicketDetail }) {
	const [hydrated, setHydrated] = useState(false)
	useEffect(() => setHydrated(true), [])
	if (!hydrated || !ticket.requesterEmail) return null
	return <PermissionAccess permission={crmPermissions.contact.read()}><Suspense fallback={<p>Loading contact…</p>}><ContactSummary email={ticket.requesterEmail} /></Suspense></PermissionAccess>
}

function ContactSummary({ email }: { email: string }) {
	const { data } = useContacts({ email, limit: 1 })
	const { Link, resolve } = usePluginSiteNavigation("crm")
	const contact = data?.items[0]
	return (
		<section className="space-y-2 rounded-lg border p-4" aria-label="CRM contact">
			<h2 className="font-semibold">CRM contact</h2>
			{contact ? <>
				<Link href={resolve(`crm/contacts/${contact.id}`).href} className="underline">{contact.firstName} {contact.lastName}</Link>
				<p className="break-all text-sm">{contact.email}</p>
				{contact.company && <p className="text-sm">{contact.company}</p>}
				{contact.title && <p className="text-sm text-muted-foreground">{contact.title}</p>}
			</> : <p className="text-sm text-muted-foreground">No matching CRM contact.</p>}
		</section>
	)
}
