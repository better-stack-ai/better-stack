{
  "name": "@btst/components",
  "version": "1.0.1-beta.1",
  "type": "module",
  "description": "Optional standalone BTST components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-stack-ai/better-stack.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./markdown": {
      "import": {
        "types": "./dist/markdown/index.d.ts",
        "default": "./dist/markdown/index.mjs"
      },
      "require": {
        "types": "./dist/markdown/index.d.cts",
        "default": "./dist/markdown/index.cjs"
      }
    },
    "./auto-form": {
      "import": {
        "types": "./dist/auto-form/index.d.ts",
        "default": "./dist/auto-form/index.mjs"
      },
      "require": {
        "types": "./dist/auto-form/index.d.cts",
        "default": "./dist/auto-form/index.cjs"
      }
    },
    "./stepped-auto-form": {
      "import": {
        "types": "./dist/stepped-auto-form/index.d.ts",
        "default": "./dist/stepped-auto-form/index.mjs"
      },
      "require": {
        "types": "./dist/stepped-auto-form/index.d.cts",
        "default": "./dist/stepped-auto-form/index.cjs"
      }
    },
    "./form-builder": {
      "import": {
        "types": "./dist/form-builder/index.d.ts",
        "default": "./dist/form-builder/index.mjs"
      },
      "require": {
        "types": "./dist/form-builder/index.d.cts",
        "default": "./dist/form-builder/index.cjs"
      }
    },
    "./multi-select": {
      "import": {
        "types": "./dist/multi-select/index.d.ts",
        "default": "./dist/multi-select/index.mjs"
      },
      "require": {
        "types": "./dist/multi-select/index.d.cts",
        "default": "./dist/multi-select/index.cjs"
      }
    },
    "./search-select": {
      "import": {
        "types": "./dist/search-select/index.d.ts",
        "default": "./dist/search-select/index.mjs"
      },
      "require": {
        "types": "./dist/search-select/index.d.cts",
        "default": "./dist/search-select/index.cjs"
      }
    },
    "./empty": {
      "import": {
        "types": "./dist/empty/index.d.ts",
        "default": "./dist/empty/index.mjs"
      },
      "require": {
        "types": "./dist/empty/index.d.cts",
        "default": "./dist/empty/index.cjs"
      }
    },
    "./markdown/css": "./dist/style.css",
    "./ui/css": "./dist/ui.css"
  },
  "typesVersions": {
    "*": {
      "markdown": [
        "./dist/markdown/index.d.ts"
      ],
      "auto-form": [
        "./dist/auto-form/index.d.ts"
      ],
      "stepped-auto-form": [
        "./dist/stepped-auto-form/index.d.ts"
      ],
      "form-builder": [
        "./dist/form-builder/index.d.ts"
      ],
      "multi-select": [
        "./dist/multi-select/index.d.ts"
      ],
      "search-select": [
        "./dist/search-select/index.d.ts"
      ],
      "empty": [
        "./dist/empty/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "unbuild --clean",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.475.0",
    "react-day-picker": "^9.13.2",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": ">=7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": ">=6.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6",
    "react-hook-form": "^7.66.1",
    "zod": "^4.6.7",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@workspace/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.66.1",
    "zod": "4.6.7",
    "tailwindcss": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  }
}
