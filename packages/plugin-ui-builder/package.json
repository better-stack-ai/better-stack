{
  "name": "@btst/plugin-ui-builder",
  "version": "1.1.0-beta.0",
  "type": "module",
  "description": "UI Builder plugin for the BTST core runtime, backed by CMS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-stack-ai/better-stack.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./client/hooks": {
      "import": {
        "types": "./dist/client/hooks/index.d.ts",
        "default": "./dist/client/hooks/index.mjs"
      },
      "require": {
        "types": "./dist/client/hooks/index.d.cts",
        "default": "./dist/client/hooks/index.cjs"
      }
    },
    "./client/components": {
      "import": {
        "types": "./dist/client/components/index.d.ts",
        "default": "./dist/client/components/index.mjs"
      },
      "require": {
        "types": "./dist/client/components/index.d.cts",
        "default": "./dist/client/components/index.cjs"
      }
    },
    "./query-keys": {
      "import": {
        "types": "./dist/query-keys.d.ts",
        "default": "./dist/query-keys.mjs"
      },
      "require": {
        "types": "./dist/query-keys.d.cts",
        "default": "./dist/query-keys.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.mjs"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./css": "./dist/style.css"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client/index.d.ts"
      ],
      "client/hooks": [
        "./dist/client/hooks/index.d.ts"
      ],
      "client/components": [
        "./dist/client/components/index.d.ts"
      ],
      "query-keys": [
        "./dist/query-keys.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "unbuild --clean",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@btst/plugin-cms": "workspace:^",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.16",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "fast-deep-equal": "^3.1.3",
    "he-tree-react": "^1.2.0",
    "immer": "^11.1.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.6",
    "object-hash": "^3.0.0",
    "react-day-picker": "^9.13.2",
    "react-error-boundary": "^4.1.2",
    "react-hook-form": "^7.66.1",
    "react-markdown": "^9.1.0",
    "react-medium-image-zoom": "^5.4.0",
    "react-resizable-panels": "^2.1.9",
    "react-syntax-highlighter": "^16.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.2.1",
    "zundo": "^2.3.0",
    "zustand": "4.5.6"
  },
  "peerDependencies": {
    "@btst/stack": ">=6.2.0-beta.0 <6.2.0",
    "@btst/yar": ">=1.3.2",
    "@tanstack/react-query": "^5.0.0",
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@btst/stack": "workspace:*",
    "@btst/yar": "1.3.2",
    "@tanstack/react-query": "5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:",
    "@btst/adapter-memory": "3.0.1",
    "jsdom": "^28.1.0",
    "@types/object-hash": "^3.0.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "tailwindcss": "4.3.3"
  },
  "types": "./dist/index.d.ts"
}
