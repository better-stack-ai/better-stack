{
  "name": "@btst/plugin-blog",
  "version": "1.1.0-beta.1",
  "type": "module",
  "description": "Blog plugin for the BTST core runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-stack-ai/better-stack.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./api": {
      "import": {
        "types": "./dist/api/index.d.ts",
        "default": "./dist/api/index.mjs"
      },
      "require": {
        "types": "./dist/api/index.d.cts",
        "default": "./dist/api/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./client/hooks": {
      "import": {
        "types": "./dist/client/hooks/index.d.ts",
        "default": "./dist/client/hooks/index.mjs"
      },
      "require": {
        "types": "./dist/client/hooks/index.d.cts",
        "default": "./dist/client/hooks/index.cjs"
      }
    },
    "./client/components": {
      "import": {
        "types": "./dist/client/components/index.d.ts",
        "default": "./dist/client/components/index.mjs"
      },
      "require": {
        "types": "./dist/client/components/index.d.cts",
        "default": "./dist/client/components/index.cjs"
      }
    },
    "./query-keys": {
      "import": {
        "types": "./dist/query-keys.d.ts",
        "default": "./dist/query-keys.mjs"
      },
      "require": {
        "types": "./dist/query-keys.d.cts",
        "default": "./dist/query-keys.cjs"
      }
    },
    "./permissions": {
      "import": {
        "types": "./dist/permissions.d.ts",
        "default": "./dist/permissions.mjs"
      },
      "require": {
        "types": "./dist/permissions.d.cts",
        "default": "./dist/permissions.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.mjs"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./css": "./dist/style.css",
    "./client/pages/posts": {
      "import": {
        "types": "./dist/client/pages/posts.d.ts",
        "default": "./dist/client/pages/posts.mjs"
      },
      "require": {
        "types": "./dist/client/pages/posts.d.cts",
        "default": "./dist/client/pages/posts.cjs"
      }
    },
    "./client/pages/post": {
      "import": {
        "types": "./dist/client/pages/post.d.ts",
        "default": "./dist/client/pages/post.mjs"
      },
      "require": {
        "types": "./dist/client/pages/post.d.cts",
        "default": "./dist/client/pages/post.cjs"
      }
    },
    "./client/pages/tag": {
      "import": {
        "types": "./dist/client/pages/tag.d.ts",
        "default": "./dist/client/pages/tag.mjs"
      },
      "require": {
        "types": "./dist/client/pages/tag.d.cts",
        "default": "./dist/client/pages/tag.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "api": [
        "./dist/api/index.d.ts"
      ],
      "client": [
        "./dist/client/index.d.ts"
      ],
      "client/hooks": [
        "./dist/client/hooks/index.d.ts"
      ],
      "client/components": [
        "./dist/client/components/index.d.ts"
      ],
      "query-keys": [
        "./dist/query-keys.d.ts"
      ],
      "permissions": [
        "./dist/permissions.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ],
      "client/pages/posts": [
        "./dist/client/pages/posts.d.ts"
      ],
      "client/pages/post": [
        "./dist/client/pages/post.d.ts"
      ],
      "client/pages/tag": [
        "./dist/client/pages/tag.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "unbuild --clean",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@btst/db": "3.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "better-call": "1.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "highlight.js": ">=11.9.0",
    "lucide-react": "^1.63.0",
    "react-error-boundary": "^4.1.2",
    "react-hook-form": "^7.66.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": ">=7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": ">=6.0.0",
    "slug": "^11.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@btst/stack": ">=6.2.0-beta.1 <6.2.0",
    "@btst/yar": ">=1.3.2",
    "@tanstack/react-query": "^5.0.0",
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6"
  },
  "devDependencies": {
    "@btst/stack": "workspace:*",
    "@btst/yar": "1.3.2",
    "@tanstack/react-query": "5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:",
    "@btst/adapter-memory": "3.0.1",
    "jsdom": "^28.1.0",
    "@types/slug": "^5.0.9"
  }
}
