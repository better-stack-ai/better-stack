{
  "name": "@btst/stack",
  "version": "6.2.0-beta.0",
  "description": "A composable, plugin-based library for building full-stack applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-stack-ai/better-stack.git"
  },
  "keywords": [
    "fullstack",
    "react",
    "nextjs"
  ],
  "author": "olliethedev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/better-stack-ai/better-stack/issues"
  },
  "homepage": "https://github.com/better-stack-ai/better-stack#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=12288' unbuild --clean",
    "build:analyze": "NODE_OPTIONS='--max-old-space-size=8192' ANALYZE=1 unbuild --clean",
    "stub": "unbuild --stub",
    "test": "vitest",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project consumer-tests/portable-authorization-contract/stack-package/tsconfig.json --outDir consumer-tests/portable-authorization-contract/stack-copy-a/dist && tsc --project consumer-tests/portable-authorization-contract/stack-package/tsconfig.json --outDir consumer-tests/portable-authorization-contract/stack-copy-b/dist && tsc --project consumer-tests/portable-authorization-contract/contract-package/tsconfig.json && tsc --project consumer-tests/portable-authorization-contract/consumer-package/tsconfig.json",
    "knip": "knip --strict",
    "build-registry": "tsx scripts/build-registry.ts",
    "test-registry": "bash scripts/test-registry.sh",
    "host-registry": "npx http-server registry -p 8766 -c-1"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
