{
  "name": "btst/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo --filter \"./packages/*\" build",
    "dev": "turbo --filter \"./packages/*\" dev",
    "dev:dts": "turbo --filter \"./packages/*\" dev:dts",
    "clean": "turbo --filter \"./packages/*\" clean && rm -rf node_modules",
    "format": "biome format . --write",
    "lint": "node scripts/check-canonical-dx.mjs && biome check .",
    "check:canonical-dx": "node scripts/check-canonical-dx.mjs",
    "capture:product-proof": "corepack pnpm --filter e2e exec node product-proof/capture.mjs",
    "check:product-proof": "node scripts/product-proof/check-assets.mjs docs/assets/product-proof/manifest.json",
    "lint:fix": "biome check . --fix --unsafe",
    "bump": "bumpp",
    "test": "turbo --filter \"./packages/*\" test",
    "test:bundle-size": "vitest run scripts/bundle-size.test.mjs",
    "test:packed-consumers": "vitest run scripts/packed-consumer/runner.test.mjs",
    "test:product-proof": "node --test scripts/product-proof/check-assets.test.mjs e2e/product-proof/fixture-cleanup.test.mjs",
    "smoke:packed-consumer": "node scripts/packed-consumer-smoke.mjs",
    "e2e:integration": "turbo --filter \"./e2e/*\" e2e:integration",
    "typecheck": "pnpm build && turbo --filter \"./packages/*\" typecheck && tsc --project tsconfig.compatibility.json",
    "knip": "turbo --filter \"./packages/*\" knip",
    "test:release-gate": "node --test scripts/release-gate/gate.test.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@changesets/cli": "3.0.3",
    "@types/bun": "^1.3.1",
    "@types/node": "^24.9.2",
    "bumpp": "^10.3.1",
    "esbuild": "0.25.12",
    "rollup-preserve-directives": "1.1.3",
    "tinyglobby": "^0.2.15",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:",
    "semver": "7.8.5",
    "@btst/plugin-ai-chat": "workspace:*",
    "@btst/plugin-blog": "workspace:*",
    "@btst/plugin-cms": "workspace:*",
    "@btst/plugin-comments": "workspace:*",
    "@btst/plugin-ecommerce": "workspace:*",
    "@btst/plugin-form-builder": "workspace:*",
    "@btst/plugin-kanban": "workspace:*",
    "@btst/plugin-media": "workspace:*",
    "@btst/plugin-open-api": "workspace:*",
    "@btst/plugin-route-docs": "workspace:*",
    "@btst/plugin-ui-builder": "workspace:*"
  }
}
