{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "scripts/package-build.ts",
    "packages/ui/src/**",
    "patches/**",
    ".nvmrc",
    ".npmrc",
    "package.json",
    "tsconfig.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "clean": {},
    "format": {
      "dependsOn": ["//#format"]
    },
    "//#format": {},
    "lint": {},
    "knip": {
      "cache": true
    },
    "test": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": []
    },
    "e2e:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["OPENAI_API_KEY"]
    },
    "typecheck": {
      "outputs": [
        "**/*.tsbuildinfo",
        "consumer-tests/portable-authorization-contract/**/dist/**"
      ],
      "cache": false,
      "dependsOn": ["build"]
    },
    "deploy": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  }
}
